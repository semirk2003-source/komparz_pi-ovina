# Skopírujte do .env.local a doplňte údaje zo Supabase (Project Settings → API).
# Bez nich beží aplikácia v demo režime nad vygenerovanými dátami.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Voliteľné: vynútiť demo režim aj s vyplnenými údajmi.
# VITE_DEMO_MODE=true
# Voliteľné: počet profilov v demo dátach (napr. 5000 na test rýchlosti).
# VITE_DEMO_PEOPLE=800
